# ========================================================
# Environment Variables (NAMES ONLY - ZERO SECRETS)
# ========================================================
# The extension reads no environment variables at runtime; user settings live
# in chrome.storage.local. These names exist for CI only.

# Release pipeline: base64 of the CRX3 signing key (see docs/auto-update.md).
# Losing this key means the extension ID can never be updated again.
CRX_PRIVATE_KEY=

# Optional: Chrome Web Store publishing. Unused unless a CWS workflow is added.
CWS_EXTENSION_ID=
CWS_PUBLISHER_ID=
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
