{
  "manifest_version": 3,
  "name": "YT Smart Chapters Pro v3.0",
  "version": "3.0.0",
  "description": "Smart jumps, mini-player widget, and custom shortcuts. Made with 💖 by pavnxet.",
  "homepage_url": "https://github.com/pavnxet/yt-timestamp-skipper",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://*.turso.io/*",
    "https://openrouter.ai/*",
    "https://claude.aikit.club/*"
  ],
  "action": {
    "default_title": "YT Smart Chapters Pro"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
